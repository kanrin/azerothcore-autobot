.vscode

# Local Go workspace when developing against a checkout of AzerothGhost.
go.work
go.work.sum

# Profiles with real credentials/DSNs; commit only the placeholder template.
profiles/*.local.yml

# Fleet files with machine-specific paths; the templates are fleet.example.yml and
# roster/example.yml.
fleet.yml
fleet.local.yml
roster/*.local.yml

# Secrets.
.env
.env.local

# Telemetry and packet traces.
*.jsonl

# Client data pulled from the server (dbc/maps/mmaps/vmaps, about 3 GB).
ac-data/

# Build output (make build / make release).
/bin/
/dist/
