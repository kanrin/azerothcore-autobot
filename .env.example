# Copy to .env.local (git-ignored) and fill in your values:
#
#   set -a; source .env.local; set +a
#
# The CLI and the live tests (-tags=e2e) read the same variables, so one file
# drives both. Stock AzerothCore defaults are shown; the AC docker images
# publish MySQL as acore:acore on 3306.

# Where the client connects for authentication (authserver).
E2E_AUTH_ADDR=127.0.0.1:3724

# The three databases. Keep the password out of any committed file.
E2E_AUTH_DSN=acore:acore@tcp(127.0.0.1:3306)/acore_auth
E2E_CHAR_DSN=acore:acore@tcp(127.0.0.1:3306)/acore_characters
E2E_WORLD_DSN=acore:acore@tcp(127.0.0.1:3306)/acore_world

# Password for the bot accounts the CLI provisions. Never read from a profile.
AUTOBOT_PASSWORD=changeme

# How much the AzerothGhost client logs: info | debug | trace | warn | error | silent.
# Unset means info; an unrecognised value is ignored.
E2E_WORLD_LOG=info

# Optional: profile path used when --profile is absent.
#AUTOBOT_PROFILE=$HOME/.config/autobot/profiles/local-ac.yml
